# CLI script to integrate link aggregation on a switch

enter candidate

# configure this network node to be a layer 2 switch
set network-instance mac-vrf-1 type mac-vrf
set network-instance mac-vrf-1 admin-state enable

# create a Logical Aggregation Group (LAG) interface and enable LACP on it
set interface lag1 admin-state enable
set interface lag1 lag lag-type lacp
set interface lag1 lag lacp lacp-mode ACTIVE

# assign interfaces participating in LAG 
set interface ethernet-1/2 admin-state enable
set interface ethernet-1/2 ethernet aggregate-id lag1
set interface ethernet-1/3 admin-state enable
set interface ethernet-1/3 ethernet aggregate-id lag1

# plug LAG subinterface to this switch, treat as layer 2 port
set network-instance mac-vrf-1 interface lag1.0
set interface lag1 subinterface 0 type bridged

# enable and plug our PC-facing port to this switch, treat as layer 2 port
set interface ethernet-1/1 admin-state enable
set network-instance mac-vrf-1 interface ethernet-1/1.0
set interface ethernet-1/1 subinterface 0 type bridged

commit now
